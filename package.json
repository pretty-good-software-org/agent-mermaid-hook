{
  "name": "@pretty-good-software-org/ts-cli-template",
  "version": "0.1.0-alpha.1",
  "description": "TypeScript CLI template with citty, pino, typed errors, and standalone builds",
  "type": "module",
  "private": true,
  "bin": {
    "hello-cli": "./dist/cli.js"
  },
  "prettier": "@pretty-good-software-org/ts-config/prettier.json",
  "scripts": {
    "dev": "bun run src/cli.ts",
    "build": "bun build ./src/cli.ts --outdir ./dist --target bun --format esm",
    "build:binary": "bun build ./src/cli.ts --compile --outfile ./dist/hello-cli",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "spell": "cspell --no-progress \"**/*.{ts,md,json}\"",
    "check:lockfile": "bun install --frozen-lockfile --dry-run",
    "check": "bun run check:lockfile && bun run typecheck && bun run lint && bun run format:check && bun run spell && bun run test"
  },
  "dependencies": {
    "citty": "0.2.2",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@pretty-good-software-org/ts-config": "2.2.0",
    "@types/bun": "1.4.2",
    "@types/node": "26.5.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.70.0",
    "eslint": "10.10.0",
    "prettier": "3.9.6",
    "cspell": "10.3.0"
  },
  "engines": {
    "bun": ">=1.1"
  }
}
